{
  "name": "girl-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "setup:visual": "npm install && npx playwright install chromium && ./scripts/install-runtime-libs.sh",
    "visual:setup": "npx playwright install chromium && ./scripts/install-runtime-libs.sh",
    "dev": "vite",
    "api": "node server/index.js",
    "build": "tsc -b && vite build",
    "lint": "eslint src server scripts",
    "test:integration": "node --test tests/integration",
    "test:integration:ci": "CI=1 node --test tests/integration",
    "test:db:up": "node scripts/test-db-up.mjs",
    "test:db:down": "node scripts/test-db-down.mjs --volumes",
    "test:integration:local": "npm run test:db:up && npm run test:integration && npm run test:db:down",
    "preview": "vite preview",
    "screenshot:miniapp": "node scripts/miniapp-screenshot.mjs",
    "screenshot:miniapp:matrix": "node scripts/miniapp-screenshot-suite.mjs",
    "screenshot:booking-item": "node scripts/booking-item-autoshot.mjs",
    "screenshot:booking-item:matrix": "node scripts/booking-item-autoshot-suite.mjs",
    "screenshot:deposit-sheet": "node scripts/deposit-sheet-autoshot.mjs",
    "screenshot:deposit-sheet:matrix": "node scripts/deposit-sheet-autoshot-suite.mjs",
    "screenshot:design-redesign": "node scripts/design-redesign-audit.mjs",
    "visual:capture:baseline": "node scripts/miniapp-visual-audit.mjs --mode capture --stage baseline",
    "visual:capture:after": "node scripts/miniapp-visual-audit.mjs --mode capture --stage after",
    "visual:compare": "node scripts/miniapp-visual-audit.mjs --mode compare",
    "visual:workflow": "node scripts/miniapp-visual-audit.mjs --mode workflow",
    "visual:workflow:smoke": "npm run visual:workflow -- --session smoke-pro-cabinet --userId 5510721194 --parallel 2",
    "visual:gate": "node scripts/visual-gate.mjs --session smoke-pro-cabinet --userId 5510721194",
    "visual:cleanup": "node scripts/cleanup-visual-logs.mjs",
    "visual:doctor": "node scripts/visual-doctor.mjs",
    "deps:baseline": "node scripts/deps-baseline.mjs",
    "deps:check": "node scripts/deps-check.mjs",
    "deps:update:safe": "node scripts/deps-safe-update.mjs",
    "agent:health": "npm run deps:check && npm run visual:doctor -- --strict 1",
    "agent:autopilot": "npm run deps:check && npm run test:integration && npm run build && npm run visual:gate && npm run visual:cleanup -- --maxAgeDays 7 --keepLatest 30",
    "agent:maintenance": "npm run deps:update:safe && npm run deps:check && npm run build"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.18",
    "@vkontakte/vk-bridge": "^2.15.11",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "iconoir-react": "^7.11.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.34.5",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "playwright": "^1.58.1",
    "supertest": "^7.1.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
